# iCtrl Server for Testing
FROM python:3.10-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    git \
    libpq-dev \
    libffi-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Copy and install requirements
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Install additional test dependencies
RUN pip install --no-cache-dir pyopenssl "coverage[toml]"

# Copy application code
COPY application/ ./application/
COPY ictrl_be.py .
COPY log_config.yaml .
COPY tests/docker/run_with_coverage.py .

# Create profile directory
RUN mkdir -p /root/.ictrl/private_keys

# Copy coverage config for consistent settings
COPY pyproject.toml .

# Create coverage output directory
RUN mkdir -p /coverage

EXPOSE 5000

# Default command (can be overridden)
# Use coverage run to collect coverage data
CMD ["coverage", "run", "--data-file=/coverage/.coverage", "ictrl_be.py", "5000", ""]
